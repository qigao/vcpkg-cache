# Paired host Lemon executable/template, backed by the shared locked restore.
include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/QigaoNativeDependency.cmake")

function(qigao_setup_lemon)
  cmake_parse_arguments(PARSE_ARGV 0 L "" "LOCK_FILE;HOST_RID;ARCHIVE_FILE" "")
  if(L_UNPARSED_ARGUMENTS OR NOT L_LOCK_FILE OR
     NOT L_HOST_RID MATCHES "^(linux|macos|windows)-(x64|arm64)$")
    message(FATAL_ERROR "qigao_setup_lemon requires LOCK_FILE and explicit host HOST_RID")
  endif()
  file(READ "${L_LOCK_FILE}" _lock)
  string(JSON _id GET "${_lock}" source id)
  string(JSON _version GET "${_lock}" source version)
  if(NOT _id STREQUAL "Qigao.Lemon.Binary")
    message(FATAL_ERROR "Lemon requires a Qigao.Lemon.Binary lock")
  endif()
  set(_binary "lemon")
  if(L_HOST_RID MATCHES "^windows-")
    set(_binary "lemon.exe")
  endif()
  qigao_restore_native_dependency(LOCK_FILE "${L_LOCK_FILE}"
    ARCHIVE_FILE "${L_ARCHIVE_FILE}" PAYLOAD "tools/${L_HOST_RID}"
    REQUIRED_FILES "share/lemon/lempar.c" "share/lemon/source.json"
    EXECUTABLES "bin/${_binary}" OUT_ROOT _root)
  set(_executable "${_root}/bin/${_binary}")
  set(_template "${_root}/share/lemon/lempar.c")
  file(READ "${_root}/share/lemon/source.json" _source)
  foreach(_key IN ITEMS package_id package_version rid)
    string(JSON _${_key} GET "${_source}" ${_key})
  endforeach()
  if(NOT _package_id STREQUAL _id OR NOT _package_version STREQUAL _version OR NOT _rid STREQUAL L_HOST_RID)
    message(FATAL_ERROR "Lemon source manifest differs from requested package/host")
  endif()
  foreach(_part IN ITEMS executable template)
    string(JSON _expected GET "${_source}" "${_part}_sha256")
    file(SHA256 "${_${_part}}" _actual)
    if(NOT _actual STREQUAL _expected)
      message(FATAL_ERROR "Lemon ${_part} differs from the paired package manifest")
    endif()
  endforeach()
  if(TARGET Lemon::Lemon)
    get_target_property(_existing Lemon::Lemon IMPORTED_LOCATION)
    if(NOT _existing STREQUAL _executable)
      message(FATAL_ERROR "Lemon::Lemon already refers to a different host package")
    endif()
  else()
    add_executable(Lemon::Lemon IMPORTED GLOBAL)
    set_target_properties(Lemon::Lemon PROPERTIES IMPORTED_LOCATION "${_executable}"
      QIGAO_LEMON_TEMPLATE "${_template}")
  endif()
  set(LEMON_EXECUTABLE "${_executable}" PARENT_SCOPE)
  set(LEMPAR "${_template}" PARENT_SCOPE)
endfunction()
