# Windows arm64 llvm-mingw UCRT dependency ABI; never alias MSVC v145.
set(VCPKG_TARGET_ARCHITECTURE arm64)
set(VCPKG_CRT_LINKAGE dynamic)
set(VCPKG_LIBRARY_LINKAGE dynamic)
set(VCPKG_CMAKE_SYSTEM_NAME MinGW)
set(VCPKG_ENV_PASSTHROUGH_UNTRACKED PATH)
if("$ENV{LLVM_MINGW_TOOLCHAIN_FILE}" STREQUAL "")
  message(FATAL_ERROR "Run setup-llvm-mingw before building arm64 MinGW packages")
endif()
set(VCPKG_CHAINLOAD_TOOLCHAIN_FILE "$ENV{LLVM_MINGW_TOOLCHAIN_FILE}")
