{
  "name": "qigao-vcpkg-cache",
  "version-string": "1",
  "description": "Warm-up manifest for shared qigao third-party vcpkg binary packages.",
  "builtin-baseline": "b1b19307e2d2ec1eefbdb7ea069de7d4bcd31f01",
  "dependencies": [
    "aklomp-base64",
    {
      "name": "bfs",
      "platform": "native & (linux | osx)"
    },
    "c-ares", 
    "cxxopts",
    "gmssl",
    "kcp",
    {
      "name": "libpq",
      "default-features": false,
      "features": [
        "zstd"
      ],
      "platform": "linux | windows"
    },
    "libusb",
    "libuv",
    "llhttp",
    "lua",
    "miniaudio",
    {
      "name": "mir-jit",
      "platform": "linux | osx | android | (windows & x64)"
    },
    "pcre2",
    {
      "name": "pkgconf",
      "host": true
    },
    "quickjs-ng",
    "simde",
    {
      "name": "sqlite3",
      "features": [
        "fts5"
      ]
    },
    "stb",
    "tiny-aes-c",
    "tree-sitter",
    "tree-sitter-c",
    {
      "name": "ugrep",
      "platform": "native & (linux | osx | (windows & !uwp & !mingw & (x86 | x64)))"
    },
    "xxhash",
    {
      "name": "zeromq",
      "default-features": false
    },
    "zlib",
    "zstd"
  ]
}
