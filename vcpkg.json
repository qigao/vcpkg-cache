{
  "name": "qigao-vcpkg-cache",
  "version-string": "1",
  "description": "Warm-up manifest for shared qigao third-party vcpkg binary packages.",
  "dependencies": [
    {
      "name": "pkgconf",
      "host": true
    },
    "simde",
    "zlib",
    "zstd",
    "aklomp-base64",
    "c-ares",
    "libuv",
    "kcp",
    {
      "name": "boringssl",
      "platform": "!linux"
    },
    "miniaudio",
    "lua",
    "libyuv",
    "libusb",
    "llhttp",
    "tree-sitter",
    "tree-sitter-c",
    "catch2",
    "xxhash",
    "cxxopts",
    "stb",
    {
      "name": "sqlite3",
      "features": [
        "fts5"
      ]
    },
    "tiny-aes-c",
    {
      "name": "mir-jit",
      "platform": "linux | osx | android"
    },
    "quickjs-ng",
    {
      "name": "libpq",
      "default-features": false,
      "features": [
        "zstd"
      ],
      "platform": "linux"
    },
    "opus",
    "libvpx",
    "openh264",
    "x265",
    "libde265",
    {
      "name": "ffmpeg",
      "features": [
        "openh264",
        "opus",
        "xml2"
      ]
    },
    "libsrtp",
    "roaring",
    "usrsctp"
  ],
  "builtin-baseline": "b1b19307e2d2ec1eefbdb7ea069de7d4bcd31f01",
  "overrides": []
}
