diff --git a/string/generate_ir_header.py b/string/generate_ir_header.py
new file mode 100644
--- /dev/null
+++ b/string/generate_ir_header.py
@@ -0,0 +1,27 @@
+import subprocess
+import sys
+from pathlib import Path
+
+
+def main():
+    compiler, source_name, output_name = sys.argv[1:]
+    source = Path(source_name).resolve()
+    output = Path(output_name).resolve()
+    output.parent.mkdir(parents=True, exist_ok=True)
+    bitcode = output.with_name(source.name + ".bc")
+    subprocess.run(
+        [compiler, "-Os", "-emit-llvm", "-c", str(source), "-o", str(bitcode)],
+        check=True)
+    payload = bitcode.read_bytes()
+    with output.open("w", encoding="ascii", newline="\n") as stream:
+        stream.write("unsigned char decode_c_bc[] = {\n")
+        for offset in range(0, len(payload), 12):
+            row = payload[offset:offset + 12]
+            stream.write("  " + ", ".join(f"0x{value:02x}" for value in row))
+            stream.write(",\n" if offset + 12 < len(payload) else "\n")
+        stream.write("};\n")
+        stream.write(f"unsigned int decode_c_bc_len = {len(payload)};\n")
+
+
+if __name__ == "__main__":
+    main()
