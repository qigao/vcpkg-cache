diff --git a/lib/regexec.c b/lib/regexec.c
--- a/lib/regexec.c
+++ b/lib/regexec.c
@@ -246,7 +246,55 @@
   return tre_match(tnfa, str, len, STR_BYTE, nmatch, pmatch, eflags);
 }
 
+/* Exact search with a minimum allowed match START on the unmodified full
+ * subject. Unlike suffix rescanning, TNFA assertions retain all prior bytes.
+ * Reject non-exact modes instead of dispatching another matcher. */
+int
+tre_regnexecb_from(const regex_t *preg, const char *str, size_t len,
+                   size_t min_start, size_t nmatch,
+                   regmatch_t pmatch[], int eflags)
+{
+  tre_tnfa_t *tnfa;
+  reg_errcode_t status;
+  int *tags = NULL;
+  int eo;
 
+  if (preg == NULL || str == NULL || preg->TRE_REGEX_T_FIELD == NULL)
+    return REG_BADPAT;
+  if (len > INT_MAX)
+    return REG_ESPACE;
+  if (min_start > len)
+    return REG_NOMATCH;
+
+  tnfa = (void *)preg->TRE_REGEX_T_FIELD;
+  if (tnfa->have_backrefs || tnfa->have_approx
+      || (eflags & (REG_BACKTRACKING_MATCHER | REG_APPROX_MATCHER)))
+    return REG_BADPAT;
+
+  if (tnfa->num_tags > 0 && nmatch > 0)
+    {
+#ifdef TRE_USE_ALLOCA
+      tags = alloca(sizeof(*tags) * tnfa->num_tags);
+#else /* !TRE_USE_ALLOCA */
+      tags = xmalloc(sizeof(*tags) * tnfa->num_tags);
+#endif /* !TRE_USE_ALLOCA */
+      if (tags == NULL)
+        return REG_ESPACE;
+    }
+
+  status = tre_tnfa_run_parallel_from(tnfa, str, (ssize_t)len, STR_BYTE,
+                                      tags, eflags, &eo, min_start);
+  if (status == REG_OK)
+    tre_fill_pmatch(nmatch, pmatch, tnfa->cflags, tnfa, tags, eo);
+
+#ifndef TRE_USE_ALLOCA
+  if (tags)
+    xfree(tags);
+#endif /* !TRE_USE_ALLOCA */
+  return status;
+}
