diff --git a/CMakeLists.txt b/CMakeLists.txt
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@
 if(NOT CMAKE_SYSTEM_NAME MATCHES "^(Generic|Android)$")
   find_package(Threads REQUIRED)
   target_link_libraries(crypto Threads::Threads)
 endif()
 
+# BoringSSL's static archives contain C++ objects. Apple C consumers still
+# link with the C driver, so export the libc++ runtime as part of the package
+# contract instead of requiring every downstream C target to add -lc++.
+if(APPLE AND NOT BUILD_SHARED_LIBS)
+  target_link_libraries(crypto PUBLIC c++)
+endif()
+
 # Every target depends on crypto, so we add libcxx as a dependency here to
 # simplify injecting it everywhere.
 if(USE_CUSTOM_LIBCXX)
