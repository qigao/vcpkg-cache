+/* Validate the top presented certificate using the same authenticated root
+ * selection as x509_certs_verify. Its issuer need not be transmitted. */
+static int tls_cert_chain_check_anchor_signature(const uint8_t *certs, size_t certslen,
+    const uint8_t *cacerts, size_t cacertslen, const int *schemes, size_t schemes_cnt)
+{
+    const uint8_t *last, *anchor;
+    size_t last_len, anchor_len;
+    X509_KEY key;
+    int alg, group, scheme;
+    if (x509_certs_get_last(certs, certslen, &last, &last_len) != 1
+        || x509_cert_chain_find_root_ca_cert(certs, certslen, cacerts, cacertslen,
+            &anchor, &anchor_len, SM2_DEFAULT_ID, SM2_DEFAULT_ID_LENGTH) != 1) return -1;
+    /* The trust anchor's own signature is outside this policy. */
+    if (last_len == anchor_len && memcmp(last, anchor, last_len) == 0) return 1;
+    if (x509_cert_get_signature_algor(last, last_len, &alg) != 1
+        || x509_cert_get_subject_public_key(anchor, anchor_len, &key) != 1) return -1;
+    if (key.algor == OID_ec_public_key) group = key.algor_param;
+    else if (key.algor == OID_rsa_encryption) group = OID_undef;
+    else return -1;
+    scheme = tls_signature_scheme_from_algorithm_and_group_oid(alg, group);
+    return scheme && tls_type_is_in_list(scheme, schemes, schemes_cnt) ? 1 : 0;
 }
 
