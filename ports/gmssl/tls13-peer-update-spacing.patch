+	ctx->peer_key_update_min_bytes = min_bytes;
+	if (min_interval_ms) { ctx->key_update_clock_ms = clock_ms; ctx->key_update_clock_user = user; }
+	else if (!ctx->key_update_interval_ms) { ctx->key_update_clock_ms = NULL; ctx->key_update_clock_user = NULL; }
