+/* The configured anchor's constraints apply to every subordinate, not only
+ * the nearest issuer. An identical presented anchor is not its own subordinate. */
+static int x509_certs_check_anchor_name_constraints(const uint8_t *chain, size_t chain_len,
+	const uint8_t *anchor, size_t anchor_len)
+{
+	const uint8_t *constraints, *last;
+	size_t constraints_len, last_len;
+	int ret;
+	if (!anchor) return 1;
+	ret = x509_cert_get_name_constraints(anchor, anchor_len, &constraints, &constraints_len);
+	if (ret < 0) return -1;
+	if (ret == 0) return 1;
+	if (x509_certs_get_last(chain, chain_len, &last, &last_len) != 1) return -1;
+	if (last_len == anchor_len && !memcmp(last, anchor, anchor_len)) chain_len -= last_len;
+	if (!chain_len) return 1;
+	return x509_certs_check_name_constraints_by_name_constraints(chain, chain_len, constraints, constraints_len);
+}
