+/* Called only for a new application/control record, never pending ciphertext. */
+static int tls13_key_update_time_sample(TLS_CONNECT *conn, uint64_t *now)
+{
+	if (!conn->key_update_timer_started || !conn->ctx->key_update_clock_ms
+		|| conn->ctx->key_update_clock_ms(conn->ctx->key_update_clock_user, now) != 1
+		|| *now < conn->key_update_last_clock_ms || *now < conn->local_key_started_ms) return -1;
+	conn->key_update_last_clock_ms = *now;
+	return 1;
+}
