+/* Bounded plain PKCS#8 admission. Only fixed-size RSA/EC key values. */
+static int tls_private_key_from_der(X509_KEY *key, const X509_KEY *pub,
+ const uint8_t *der, size_t len)
+{
+ const uint8_t *attrs = NULL;
+ size_t attrslen = 0;
+ if (!der || !len || len > 8192) return -1;
+ if (pub->algor == OID_rsa_encryption) {
+  if (rsa_private_key_info_from_der(&key->rsa_private_key, &attrs, &attrslen, &der, &len) != 1) return -1;
+  key->algor = OID_rsa_encryption;
+  key->algor_param = OID_undef;
+  key->u.rsa_public_key = key->rsa_private_key.public_key;
+  key->has_private_key = 1;
+ } else if (pub->algor == OID_ec_public_key) {
+  if (x509_private_key_info_from_der(key, &attrs, &attrslen, &der, &len) != 1
+   || key->algor != OID_ec_public_key
+   || (key->algor_param != OID_sm2 && key->algor_param != OID_secp256r1)) return -1;
+ } else return -1;
+ return !len && !attrslen && x509_public_key_equ(key, pub) == 1 ? 1 : -1;
+}
+
+int tls_ctx_set_certificate_and_keys_der(TLS_CTX *ctx,
+ const uint8_t *certs, size_t certslen, const uint8_t *key, size_t keylen,
+ const uint8_t *enc_key, size_t enc_keylen)
+{
+ X509_KEY keys[2] = {0}, pub = {0};
+ const uint8_t *cert;
+ size_t certlen, count, i, outlen = 0;
+ uint8_t *out;
+ int ret = -1, tlcp;
+ if (!ctx || !certs || !certslen || !key || !keylen
+  || !tls_protocol_name(ctx->protocol) || ctx->cert_chains_len || ctx->x509_keys_cnt
+  || certslen > sizeof(ctx->cert_chains) - 3) return -1;
+ tlcp = ctx->protocol == TLS_protocol_tlcp;
+ if (tlcp && (ctx->is_client || !enc_key || !enc_keylen)) return -1;
+ if (!tlcp && (enc_key || enc_keylen)) return -1;
+ count = tlcp ? 2 : 1;
+ if ((tlcp ? tlcp_cert_chain_check_order(certs, certslen)
+  : tls_cert_chain_check_order(certs, certslen)) != 1) return -1;
+ for (i = 0; i < count; i++) {
+  if (x509_certs_get_cert_by_index(certs, certslen, i, &cert, &certlen) != 1
+   || x509_cert_get_subject_public_key(cert, certlen, &pub) != 1
+   || (tlcp && (pub.algor != OID_ec_public_key || pub.algor_param != OID_sm2))
+   || tls_private_key_from_der(&keys[i], &pub, i ? enc_key : key, i ? enc_keylen : keylen) != 1) goto end;
+ }
+ /* No context mutation until both keys and the complete chain pass. */
+ out = ctx->cert_chains;
+ tls_uint24array_to_bytes(certs, certslen, &out, &outlen);
+ ctx->cert_chains_len = outlen;
+ ctx->x509_keys[0] = keys[0];
+ if (tlcp) ctx->enc_keys[0] = keys[1];
+ ctx->x509_keys_cnt = 1;
+ if (!tlcp) {
+  out = ctx->status_request_ocsp_responses;
+  tls_uint24array_to_bytes(NULL, 0, &out, &ctx->status_request_ocsp_responses_len);
+  out = ctx->signed_certificate_timestamp_lists;
+  tls_uint16array_to_bytes(NULL, 0, &out, &ctx->signed_certificate_timestamp_lists_len);
+ }
+ ret = 1;
+end:
+ gmssl_secure_clear(keys, sizeof(keys));
+ gmssl_secure_clear(&pub, sizeof(pub));
+ return ret;
+}
