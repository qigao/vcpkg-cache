+
+/* TLCP's first two certificates are siblings, not child/issuer. Resolve
+ * their common issuer from the verified chain or explicit anchors before
+ * mapping certificate algorithms. Never use the encryption leaf as an issuer. */
+static int tlcp_cert_chain_check_signatures(const uint8_t *certs, size_t certslen,
+    const uint8_t *anchors, size_t anchorslen, const int *schemes, size_t count)
+{
+    const uint8_t *leaf[2], *issuer, *rest;
+    size_t sizes[2], issuerlen, restlen;
+    X509_KEY key;
+    int group, alg, scheme;
+    if (x509_cert_from_der(&leaf[0], &sizes[0], &certs, &certslen) != 1
+        || x509_cert_from_der(&leaf[1], &sizes[1], &certs, &certslen) != 1) return -1;
+    rest = certs; restlen = certslen;
+    if (certslen) {
+        if (x509_cert_from_der(&issuer, &issuerlen, &certs, &certslen) != 1) return -1;
+    } else if (x509_cert_chain_find_root_ca_cert(leaf[0], sizes[0], anchors, anchorslen,
+        &issuer, &issuerlen, SM2_DEFAULT_ID, SM2_DEFAULT_ID_LENGTH) != 1) return -1;
+    if (x509_cert_get_subject_public_key(issuer, issuerlen, &key) != 1) return -1;
+    if (key.algor == OID_ec_public_key) group = key.algor_param;
+    else if (key.algor == OID_rsa_encryption) group = OID_undef;
+    else return -1;
+    for (size_t i = 0; i < 2; i++) {
+        if (x509_cert_get_signature_algor(leaf[i], sizes[i], &alg) != 1) return -1;
+        scheme = tls_signature_scheme_from_algorithm_and_group_oid(alg, group);
+        if (!scheme || !tls_type_is_in_list(scheme, schemes, count)) return 0;
+    }
+    return restlen ? tls_cert_chain_match_signature_algorithms_cert(rest, restlen, schemes, count) : 1;
 }
 
