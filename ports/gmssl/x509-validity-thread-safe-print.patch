+/* Keep ctime's local-time text and trailing newline, but never borrow its
+ * process-wide storage. DER years and a local-time day rollover fit here. */
+static int x509_validity_time_print(FILE *fp, int fmt, int ind,
+	const char *label, time_t tv)
+{
+	enum { X509_VALIDITY_TIME_TEXT_SIZE = 32 };
+	char text[X509_VALIDITY_TIME_TEXT_SIZE];
+
+#if defined(_WIN32)
+	/* The Windows CRT documents 1970..3000. Reject unsupported values before
+	 * its invalid-parameter handler can terminate certificate diagnostics. */
+	const uint64_t max_crt_time = UINT64_C(32535215999);
+	if (tv < 0 || (uint64_t)tv > max_crt_time) return -1;
+	if (ctime_s(text, sizeof(text), &tv) != 0) return -1;
+#else
+	if (ctime_r(&tv, text) == NULL) return -1;
+#endif
+	format_print(fp, fmt, ind, "%s: %s", label, text);
+	return 1;
+}
