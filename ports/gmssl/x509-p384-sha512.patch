diff --git a/src/tls-cert-signature.h b/src/tls-cert-signature.h
new file mode 100644
--- /dev/null
+++ b/src/tls-cert-signature.h
@@ -0,0 +1,23 @@
+#ifndef GMSSL_TLS_CERT_SIGNATURE_H
+#define GMSSL_TLS_CERT_SIGNATURE_H
+
+#include <gmssl/tls.h>
+
+int tls_cert_chain_match_signature_algorithms_for_protocol(int protocol,
+	const uint8_t *cert_chain, size_t cert_chain_len,
+	const int *schemes, size_t schemes_cnt);
+
+static inline int tls_certificate_signature_scheme(int protocol, int alg_oid, int group_oid)
+{
+#ifdef ENABLE_SECP384R1
+	/* RFC 8446 4.2.3 preserves the TLS 1.2 ECDSA hash/signature pairs. */
+	if (protocol == TLS_protocol_tls12 && alg_oid == OID_ecdsa_with_sha512
+		&& group_oid == OID_secp384r1) {
+		return TLS_sig_ecdsa_secp521r1_sha512;
+	}
+#endif
+	(void)protocol;
+	return tls_signature_scheme_from_algorithm_and_group_oid(alg_oid, group_oid);
+}
+
+#endif
