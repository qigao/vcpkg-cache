+/* Literal A-label DNS names, with one complete leftmost wildcard label in
+ * certificate names only. No CN fallback, partial wildcard or suffix match. */
+static int tls_dns_name_valid(const uint8_t *name, size_t len)
+{
+ size_t label = 0, i;
+ if (!name || !len || len > 253) return 0;
+ for (i = 0; i < len; i++) {
+  unsigned c = name[i];
+  if (c == '.') {
+   if (!label || name[i-1] == '-') return 0;
+   label = 0;
+  } else {
+   if (!((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') ||
+       (c >= '0' && c <= '9') || c == '-') || (!label && c == '-') || ++label > 63) return 0;
+  }
+ }
+ return label && name[len-1] != '-';
+}
+
+static int tls_dns_name_match(const uint8_t *cert, size_t certlen,
+ const uint8_t *host, size_t hostlen)
+{
+ size_t i;
+ if (certlen > 2 && cert[0] == '*' && cert[1] == '.') {
+  cert += 2; certlen -= 2;
+  /* Match exactly one nonempty host label. */
+  for (i = 0; i < hostlen && host[i] != '.'; i++) {}
+  if (!i || i == hostlen) return 0;
+  host += i + 1; hostlen -= i + 1;
+ }
+ if (!tls_dns_name_valid(cert, certlen) || certlen != hostlen) return 0;
+ for (i = 0; i < certlen; i++) {
+  unsigned a = cert[i], b = host[i];
+  if (a >= 'A' && a <= 'Z') a += 'a' - 'A';
+  if (b >= 'A' && b <= 'Z') b += 'a' - 'A';
+  if (a != b) return 0;
+ }
+ return 1;
+}
+
+int tls_cert_match_server_name(const uint8_t *cert, size_t certlen,
+ const uint8_t *host_name, size_t host_name_len)
+{
+ const uint8_t *exts, *encoded, *names, *name;
+ size_t extslen, encodedlen, nameslen, namelen;
+ int critical, choice, ret, matched = 0;
+ if (!cert || !certlen || !tls_dns_name_valid(host_name, host_name_len)) return 0;
+ ret = x509_cert_get_exts(cert, certlen, &exts, &extslen);
+ if (ret != 1) return ret;
+ ret = x509_exts_get_ext_by_oid(exts, extslen, OID_ce_subject_alt_name,
+  &critical, &encoded, &encodedlen);
+ if (ret != 1) return ret;
+ if (asn1_sequence_from_der(&names, &nameslen, &encoded, &encodedlen) != 1 || encodedlen || !nameslen) return -1;
+ while (nameslen) {
+  if (x509_general_name_from_der(&choice, &name, &namelen, &names, &nameslen) != 1) return -1;
+  if (choice == X509_gn_dns_name && tls_dns_name_match(name, namelen, host_name, host_name_len)) matched = 1;
+ }
+ return matched;
