+
+/*
+ * GM/T 0024-2023 uses a hash/signature pair (SM3=7, SM2=4).
+ * RFC 8998's 0x0708 remains the internal SM2 scheme and the TLS 1.3
+ * wire value. Translate only the TLCP ClientHello extension.
+ */
+#define TLCP_SIGNATURE_SM2_SM3 0x0704
+
+static int tlcp_signature_algorithms_ext_to_bytes(const int *algs, size_t count,
+	uint8_t **out, size_t *outlen)
+{
+	size_t i;
+	if (!algs || !count || count > (65535 - 2)/2 || !outlen) {
+		error_print();
+		return -1;
+	}
+	for (i = 0; i < count; i++) {
+		if (algs[i] != TLS_sig_sm2sig_sm3) {
+			error_print();
+			return -1;
+		}
+	}
+	tls_uint16_to_bytes(TLS_extension_signature_algorithms, out, outlen);
+	tls_uint16_to_bytes((uint16_t)(2 + 2 * count), out, outlen);
+	tls_uint16_to_bytes((uint16_t)(2 * count), out, outlen);
+	for (i = 0; i < count; i++) {
+		tls_uint16_to_bytes(TLCP_SIGNATURE_SM2_SM3, out, outlen);
+	}
+	return 1;
+}
+
+static int tlcp_process_signature_algorithms(const uint8_t *data, size_t len)
+{
+	const uint8_t *algs;
+	size_t algslen;
+	int found = 0;
+	if (tls_uint16array_from_bytes(&algs, &algslen, &data, &len) != 1
+		|| len || !algslen || (algslen & 1)) {
+		error_print();
+		return -1;
+	}
+	while (algslen) {
+		uint16_t alg;
+		if (tls_uint16_from_bytes(&alg, &algs, &algslen) != 1) {
+			error_print();
+			return -1;
+		}
+		if (alg == TLCP_SIGNATURE_SM2_SM3) {
+			found = 1;
+		}
+	}
+	return found;
+}
 
