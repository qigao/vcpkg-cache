+/* RFC 4055 RSASSA-PSS-params for SHA-256, MGF1(SHA-256), 32-byte salt
+ * and the default trailerField. Encode SHA-256 identifiers without NULL. */
+static const uint8_t pss_sha256_params[] = {
+	0x30,0x30,
+	0xa0,0x0d,0x30,0x0b,0x06,0x09,0x60,0x86,0x48,0x01,0x65,0x03,0x04,0x02,0x01,
+	0xa1,0x1a,0x30,0x18,0x06,0x09,0x2a,0x86,0x48,0x86,0xf7,0x0d,0x01,0x01,0x08,
+	0x30,0x0b,0x06,0x09,0x60,0x86,0x48,0x01,0x65,0x03,0x04,0x02,0x01,
+	0xa2,0x03,0x02,0x01,0x20,
+};
+
+static int x509_pss_sha256_params_check(const uint8_t *d, size_t dlen)
+{
+	const uint8_t *params, *field, *mgf;
+	size_t params_len, field_len, mgf_len;
+	uint32_t nodes[ASN1_OID_MAX_NODES];
+	size_t nodes_count;
+	int hash, salt, trailer;
+	int ret;
+
+	if (asn1_sequence_from_der(&params, &params_len, &d, &dlen) != 1 || dlen
+		|| asn1_explicit_from_der(0, &field, &field_len, &params, &params_len) != 1
+		|| x509_digest_algor_from_der(&hash, &field, &field_len) != 1
+		|| hash != OID_sha256 || field_len
+		|| asn1_explicit_from_der(1, &field, &field_len, &params, &params_len) != 1
+		|| asn1_sequence_from_der(&mgf, &mgf_len, &field, &field_len) != 1 || field_len
+		|| asn1_object_identifier_from_der(nodes, &nodes_count, &mgf, &mgf_len) != 1
+		|| nodes_count != oid_cnt(oid_mgf1) || memcmp(nodes, oid_mgf1, sizeof(oid_mgf1))
+		|| x509_digest_algor_from_der(&hash, &mgf, &mgf_len) != 1
+		|| hash != OID_sha256 || mgf_len
+		|| asn1_explicit_from_der(2, &field, &field_len, &params, &params_len) != 1
+		|| asn1_int_from_der(&salt, &field, &field_len) != 1
+		|| salt != 32 || field_len) {
+		return -1;
+	}
+	ret = asn1_explicit_from_der(3, &field, &field_len, &params, &params_len);
+	if (ret < 0 || params_len
+		|| (ret == 1 && (asn1_int_from_der(&trailer, &field, &field_len) != 1
+			|| trailer != 1 || field_len))) {
+		return -1;
+	}
+	return 1;
+}
